{
  "name": "netlab-3d",
  "productName": "NetLab 3D",
  "version": "1.0.0",
  "description": "NetLab 3D — jogo educativo de redes de computadores em 3D (Three.js)",
  "main": "electron/main.js",
  "author": "bentomisaelmanhice-web",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.netlab3d.app",
    "productName": "NetLab 3D",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "src/**/*",
      "vendor/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "NetLab3D-Setup-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
